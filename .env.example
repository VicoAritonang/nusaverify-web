# Copy to .env.local and fill in.

# Supabase — read by the browser and server (lib/supabase.ts).
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI agent backend — server only (app/api/analyze/route.ts).
# Webhook that receives { context, image?, ticker? } and starts an analysis.
MAIN_AGENT_WEBHOOK_URL=
# Sent verbatim as the Authorization header to the webhook.
X_API_KEY=
